; driver-vedirect — local configuration
; ======================================
; Copy this file to config.ini and override only what differs from
; config.default.ini. config.ini is gitignored — it holds this
; installation's real MQTT broker host and any hardware-specific settings.

[mqtt]
host = 192.168.1.10

[serial]
; Check `ls /dev/serial/by-id` on the Pi: the default port_globs are a guess for the Duppa quad adapter.
; port_globs = usb-Duppa_srl_*, usb-VictronEnergy_*

; Relabel one instance; the key is the lowercased SER# or the interface tail (e.g. if02).
; [device.if02]
; name = House battery

; Choose the topic instance id too (renewvan/battery/house/...); a-z, 0-9, - and _ only, unique.
; Changing it later splits logger history. The key above stays the lookup.
; [device.if02]
; id = house
; name = House battery
